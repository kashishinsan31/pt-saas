rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /clients/{clientId} {
      allow read, create, delete: if true;
      allow update: if !(
        'healthDeclaration' in resource.data
        && resource.data.healthDeclaration is map
        && resource.data.healthDeclaration.get('signed', false) == true
      ) || (
        'healthDeclaration' in request.resource.data
        && request.resource.data.healthDeclaration == resource.data.healthDeclaration
      );
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
